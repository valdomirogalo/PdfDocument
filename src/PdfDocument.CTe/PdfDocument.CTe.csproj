<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PdfDocument.CTe</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <NoWarn>$(NoWarn);CS1591;NU1510</NoWarn>
    <Description>CTe (Conhecimento de Transporte Eletrônico) plugin for PdfDocument — XML parser and DACTE renderer.</Description>
    <PackageId>PdfDocument.CTe</PackageId>
    <Version>1.0.1</Version>
    <Authors>Valdomiro Galo</Authors>
    <Product>PdfDocument.CTe</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/valdomirogalo/PdfDocument</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>pdf;dacte;cte;brazil;conhecimento-transporte;xml</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfDocument\PdfDocument.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>PdfDocument.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
